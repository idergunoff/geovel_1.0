{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geovel.local/schemas/core-description-dictionary.json",
  "title": "GeoVel core-description semantic dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "canonical_value", "patterns", "pattern_type", "priority", "enabled"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"enum": ["rock", "rock_relation", "oil_indicator", "oil_saturation", "negation", "uncertainty", "ignore"]},
          "canonical_value": {"type": "string", "minLength": 1},
          "patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "pattern_type": {"enum": ["word", "phrase", "regex"]},
          "priority": {"type": "integer"},
          "enabled": {"type": "boolean"},
          "comment": {"type": "string"}
        }
      }
    }
  }
}
